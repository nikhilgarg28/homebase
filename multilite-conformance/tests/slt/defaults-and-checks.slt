CREATE TABLE inventory (
  tenant TEXT NOT NULL,
  id INTEGER NOT NULL,
  label TEXT CONSTRAINT label_default DEFAULT ('unlabeled'),
  quantity NUMERIC DEFAULT ('3.0'),
  CONSTRAINT inventory_pk PRIMARY KEY (tenant, id),
  CONSTRAINT quantity_nonnegative CHECK (quantity >= 0)
) WITHOUT ROWID

