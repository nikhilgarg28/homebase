statement ok
CREATE TABLE typed_values (
  id INTEGER PRIMARY KEY,
  amount DECIMAL(10, 2),
  label VARCHAR(40),
  payload BLOB,
  ratio DOUBLE PRECISION,
  enabled BOOLEAN,
  anything ANY
)

statement ok
INSERT INTO typed_values VALUES (1, '7', 8, 9, '10.5', '1', '12')

query TTTTTT
SELECT
  typeof(amount),
  typeof(label),
  typeof(payload),
  typeof(ratio),
  typeof(enabled),
  typeof(anything)
FROM typed_values
----
integer
text
integer
real
integer
integer

