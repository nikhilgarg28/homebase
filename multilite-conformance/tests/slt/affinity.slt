CREATE TABLE integer_names (
  exact INTEGER PRIMARY KEY,
  integer_affinity INT NOT NULL UNIQUE,
  surprising "FLOATING POINT",
  ordinary STRING
)

statement ok
INSERT INTO integer_names VALUES (5, '6', '7', '8')

query TTTT
SELECT
  typeof(exact),
  typeof(integer_affinity),
  typeof(surprising),
  typeof(ordinary)
FROM integer_names
----
integer
integer
integer
integer
