CREATE TABLE policies (
    id INTEGER PRIMARY KEY ON CONFLICT REPLACE,
    email TEXT UNIQUE ON CONFLICT IGNORE,
    body TEXT NOT NULL ON CONFLICT REPLACE DEFAULT 'fallback',
    tenant TEXT,
    handle TEXT,
    UNIQUE (tenant, handle) ON CONFLICT REPLACE
)

